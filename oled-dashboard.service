[Unit]
Description=AI recorder OLED dashboard
After=multi-user.target NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/oled-dashboard.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oled-dashboard

[Install]
WantedBy=multi-user.target
